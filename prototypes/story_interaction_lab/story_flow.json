    {"id": "c06_fang", "scene": "C06", "title": "方仲山的账桌", "lines": [{"kind": "narration", "text": "伙计贴近说了句什么；方仲山合上小账册离开，账簿与座单仍摊着。"}], "next": "c07_hotspot"},
    {"id": "c06_scenery", "scene": "C06", "title": "景片下沿", "lines": [{"kind": "narration", "text": "一排吊景中，有一片下沿高出约半尺。这里只能看到高度差，看不到绳排。"}], "next": "c07_hotspot"},
    {"id": "c06_chen", "scene": "C06", "title": "陈九生与阿成", "lines": [{"kind": "dialogue", "speaker": "陈九生", "text": "林小姐刚才去哪了？"}, {"kind": "dialogue", "speaker": "阿成", "text": "更衣间那边。"}], "next": "c07_hotspot"},
    {"id": "c07_hotspot", "scene": "C07", "title": "谢幕前后", "lines": [{"kind": "narration", "text": "谢幕锣将响。当前位置仍有两处可看，只能选一处。"}], "choice_source": "end_hotspots"},
    {"id": "c07_stable", "scene": "C07", "title": "林怀安谢幕", "lines": [{"kind": "narration", "text": "林怀安能自行走下台，疲惫但步子稳定。"}], "next": "c08_wait"},
    {"id": "c07_fang", "scene": "C07", "title": "前场出口", "lines": [{"kind": "narration", "text": "方仲山的账桌一直空着，伙计来找人未果。"}], "next": "c08_wait"},
    {"id": "c07_route", "scene": "C07", "title": "林怀安的路线", "lines": [{"kind": "narration", "text": "林怀安从台上下来，沿通道中央朝侧厅走。"}], "next": "c08_wait"},
    {"id": "c07_shadow", "scene": "C07", "title": "铁梯方向", "lines": [{"kind": "narration", "text": "片刻后，铁梯方向有一道模糊人影移动，无法辨认。"}], "next": "c08_wait"},
    {"id": "c07_chen", "scene": "C07", "title": "陈九生原本站位", "lines": [{"kind": "narration", "text": "陈九生在谢幕锣响前离开，掌声将停时才从侧台另一端回来。"}], "next": "c08_wait"},

    {
      "id": "c08_wait", "scene": "C08", "title": "侧厅无人", "location": "春和侧厅",
      "lines": [{"kind": "narration", "text": "桌上有一只已经凉下来的茶杯，林怀安没有出现。墙上镜子蒙着布；布边整齐，颜色比周围积灰浅。"}, {"kind": "dialogue", "speaker": "玉棠", "text": "他不是往侧厅来了？"}, {"kind": "dialogue", "speaker": "场务", "text": "我看他从台侧下的。"}, {"kind": "narration", "text": "玉棠转向侧台通道，阿成提灯跟去。"}],
      "choices": [{"id": "route_follow", "label": "跟过去", "target": "c08_follow", "effects": [{"method": "choose_route", "args": ["跟过去"]}]}, {"id": "route_wait", "label": "留在侧厅，先看约见处", "target": "c08_stay", "effects": [{"method": "choose_route", "args": ["留在侧厅"]}]}]
    },
    {"id": "c08_follow", "scene": "C08", "title": "跟进通道", "lines": [{"kind": "narration", "text": "沈砚舟紧跟在后，转入通道。"}, {"kind": "dialogue", "speaker": "玉棠", "text": "爹！"}], "next": "c09_first"},
    {"id": "c08_stay", "scene": "C08", "title": "留在侧厅", "lines": [{"kind": "narration", "text": "茶已经凉透。镜子仍蒙着布，布比镜框和墙面的积灰新，没有被掀动。随后通道传来玉棠的喊声，沈砚舟和场务赶去。"}], "next": "c09_first", "on_enter": [{"method": "record_waiting_scene"}]},
    {"id": "c09_first", "scene": "C09", "title": "第一眼", "location": "侧台通道", "lines": [{"kind": "narration", "text": "林怀安倒在通道里。玉棠跪在身边，阿成把灯放在地上并喊许济川。人群围上来之前，沈砚舟先看哪里？"}], "choice_source": "first_looks"},
    {"id": "c09_neck", "scene": "C09", "title": "许济川的手", "lines": [{"kind": "narration", "text": "许济川摸脉、听呼吸，手指滑到林怀安颈侧时停了一瞬，随即拉回护领继续抢救。"}], "next": "c10_drug"},
    {"id": "c09_position", "scene": "C09", "title": "倒下的位置", "lines": [{"kind": "narration", "text": "林怀安倒在侧台岔口靠墙处。"}], "next": "c10_drug"},
    {"id": "c09_crowd", "scene": "C09", "title": "周围的人", "lines": [{"kind": "narration", "text": "阿成站在人群外，先看玉棠；陈九生随后从侧台另一端快步回来。"}], "next": "c10_drug"},

    {
      "id": "c10_drug", "scene": "C10", "title": "药盒落地", "location": "侧台通道",
      "lines": [{"kind": "dialogue", "speaker": "许济川", "text": "玉棠，人没救回来。先别动。"}, {"kind": "narration", "text": "玉棠伸进林怀安外褂内侧，摸出小药盒。看清盒面后，她想把药盒收进袖口；盒盖勾住衣料，掉在石板上。"}, {"kind": "dialogue", "speaker": "玉棠", "text": "这是我爹的东西。药是你配的。要问也该先问你。"}, {"kind": "dialogue", "speaker": "许济川", "text": "把药盒放回去。等警察来，谁都不要再碰。"}, {"kind": "dialogue", "speaker": "阿成", "text": "玉棠，先把药放下。"}, {"kind": "dialogue", "speaker": "玉棠", "text": "你闭嘴。"}, {"kind": "narration", "text": "方仲山安排报案、关半扇前门，把侧厅小桌拖到众人可见处。玉棠最终把药盒丢到桌面。"}],
      "next": "c11_rumor", "on_enter": [{"method": "record_drug_scene"}]
    },
    {
      "id": "c11_rumor", "scene": "C11", "title": "一个版本先传出去了", "location": "侧台通道",
      "lines": [{"kind": "dialogue", "speaker": "场务", "text": "前头都在问，林班主是不是心口病又犯了。"}, {"kind": "dialogue", "speaker": "许济川", "text": "我只说他有心疾。没说这是死因。"}, {"kind": "dialogue", "speaker": "方仲山", "text": "就说身体不适，今晚不见客。先把人散开。"}, {"kind": "narration", "text": "通道外很快有人把“有心疾”说成“旧疾发作”。门口已有急促脚步。"}],
      "next": "c12_choice", "on_enter": [{"method": "record_rumor_scene"}]
    },
    {
      "id": "c12_choice", "scene": "C12", "title": "警方到场前", "lines": [{"kind": "narration", "text": "脚步声从前场传来。沈砚舟只来得及做一件事。"}],
      "choices": [{"id": "pre_guard", "label": "留在药盒附近", "target": "c12_guard", "effects": [{"method": "choose_prepolice_action", "args": ["守药盒"]}]}, {"id": "pre_route", "label": "沿林怀安来路走一遍", "target": "c12_route", "effects": [{"method": "choose_prepolice_action", "args": ["复走路线"]}]}, {"id": "pre_bridge", "label": "沿铁梯上天桥", "target": "c12_bridge", "effects": [{"method": "choose_prepolice_action", "args": ["上天桥"]}]}]
    },
    {"id": "c12_guard", "scene": "C12", "title": "守在药盒旁", "lines": [{"kind": "dialogue", "speaker": "玉棠", "text": "那本来就是我爹的。"}, {"kind": "dialogue", "speaker": "阿成", "text": "别动，玉棠。人都看着。"}, {"kind": "narration", "text": "她看见沈砚舟在门边，停下。"}], "next": "c13_arrival", "on_enter": [{"method": "record_prepolice_observation"}]},
    {"id": "c12_route", "scene": "C12", "title": "复走路线", "lines": [{"kind": "narration", "text": "沈砚舟从倒地处走回舞台出口，再走向侧厅。舞台出口到侧厅的最短路线不经过靠墙岔口。"}], "next": "c13_arrival", "on_enter": [{"method": "record_prepolice_observation"}]},
    {"id": "c12_bridge", "scene": "C12", "title": "沿铁梯上天桥", "lines": [{"kind": "narration", "text": "沈砚舟沿贴墙铁梯上楼。戏还没有散净，外人不能上来。"}], "choices": [{"id": "bridge_look_down", "label": "向下看", "target": "c12_bridge_down"}]},
    {"id": "c12_bridge_down", "scene": "C12", "title": "天桥向下", "lines": [{"kind": "narration", "text": "铁梯下到底，几步便到倒地处附近。"}], "choices": [{"id": "bridge_rope_row", "label": "查看整排吊绳", "target": "c12_bridge_row"}]},
    {"id": "c12_bridge_row", "scene": "C12", "title": "整排吊绳", "lines": [{"kind": "narration", "text": "大部分绳尾高度相近，一根明显收得更高。"}], "choices": [{"id": "bridge_rope_close", "label": "查看收得较高的吊绳", "target": "c12_bridge_close"}]},
    {"id": "c12_bridge_close", "scene": "C12", "title": "收得较高的吊绳", "lines": [{"kind": "narration", "text": "绳尾短半尺，横杆多绕一道，边缘粘着浅色新麻毛。后台伙计在梯下抬头。"}, {"kind": "dialogue", "speaker": "后台伙计", "text": "你——谁让你上去的？"}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "没人。"}], "next": "c13_arrival", "on_enter": [{"method": "record_prepolice_observation"}]},

    {
      "id": "c13_arrival", "scene": "C13", "title": "警方进场", "location": "侧台通道",
      "lines": [{"kind": "narration", "text": "顾承钧带两名警员进入侧台，看见林怀安、分散站开的人、桌上的药盒与沈砚舟。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "外头已经传成心疾了。谁先说的？"}, {"kind": "dialogue", "speaker": "许济川", "text": "我说过他有心疾。没说这是死因。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "报案的是谁？碰过死者的、碰过药盒的，分开站。"}, {"kind": "narration", "text": "门房老周、玉棠与许济川依次回答。玉棠说自己想救父亲；许济川指出她曾想收走药盒。顾承钧制止两人争辩。"}, {"kind": "narration", "text": "警员画下尸体与通道位置，封存桌上的药盒，将相关人员分别带开问话。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "沈记者，你也留下。单独记一份。"}],
      "next": "c14_statement"
    },
    {
      "id": "c14_statement", "scene": "C14", "title": "沈砚舟的笔录", "location": "侧厅内侧",
      "lines": [{"kind": "dialogue", "speaker": "顾承钧", "text": "姓名，哪家报馆，再报一遍。今晚来做什么？"}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "沈砚舟，《雾港日报》。来采访今晚的纪念演出。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "演出前见过林怀安？"}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "见过。"}],
      "next_rules": [{"requires": {"letter_control": "lin"}, "target": "c14_letter_found"}, {"target": "c14_scope"}]
    },
    {"id": "c14_letter_found", "scene": "C14", "title": "笔录中的留底", "lines": [{"kind": "narration", "text": "警员从林怀安内褂夹袋找到采访函留底。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "这张是你给他的？"}, {"kind": "narration", "text": "沈砚舟说明这是报馆发函留底；留底原件列入证物。"}], "next": "c14_actual", "on_enter": [{"method": "police_finds_letter"}]},
    {"id": "c14_scope", "scene": "C14", "title": "笔录范围", "lines": [{"kind": "dialogue", "speaker": "顾承钧", "text": "谈了什么？"}], "choices": [{"id": "police_scope_performance", "label": "纪念演出的采访。", "target": "c14_scope_shallow", "effects": [{"method": "record_police_scope", "args": ["performance"]}]}, {"id": "police_scope_old_report", "label": "还问了二十年前那篇旧报。", "target": "c14_scope_shallow", "effects": [{"method": "record_police_scope", "args": ["old_report"]}]}, {"id": "police_scope_contact", "label": "赵敬文死前寄过采访函，想核实旧报里的一句话。", "target": "c14_scope_contact", "effects": [{"method": "record_police_scope", "args": ["contact"]}]}]},
    {"id": "c14_scope_shallow", "scene": "C14", "title": "笔录范围", "lines": [{"kind": "narration", "text": "顾承钧写下沈砚舟的回答，翻到下一行。"}], "next": "c14_actual"},
    {"id": "c14_scope_contact", "scene": "C14", "title": "笔录范围", "lines": [{"kind": "narration", "text": "赵敬文、采访函与旧报核实被写进警方笔录。"}, {"kind": "narration", "text": "沈砚舟展示抄页，说明原件仍在报馆。", "requires": {"letter_form": "copy"}}], "next_rules": [{"requires": {"letter_form": "original", "letter_control": "reporter"}, "target": "c14_letter_choice"}, {"target": "c14_actual"}]},
    {"id": "c14_letter_choice", "scene": "C14", "title": "留底原件", "lines": [{"kind": "narration", "text": "采访函留底仍在沈砚舟公文袋中。"}], "choices": [{"id": "police_letter_submit", "label": "交出采访函留底", "target": "c14_letter_submitted", "effects": [{"method": "decide_police_letter", "args": ["submit"]}]}, {"id": "police_letter_retain", "label": "逐字说明内容，保留留底原件", "target": "c14_letter_retained", "effects": [{"method": "decide_police_letter", "args": ["retain"]}]}]},
    {"id": "c14_letter_submitted", "scene": "C14", "title": "留底原件", "lines": [{"kind": "narration", "text": "顾承钧封存留底原件并开出收条。"}], "next": "c14_actual"},
    {"id": "c14_letter_retained", "scene": "C14", "title": "留底原件", "lines": [{"kind": "narration", "text": "笔录注明留底原件仍由沈砚舟持有。"}], "next": "c14_actual"},
    {"id": "c14_actual", "scene": "C14", "title": "到场与第一眼核对", "lines": [{"kind": "dialogue", "speaker": "顾承钧", "text": "你什么时候到侧厅？谁先发现人？你第一眼看见什么？"}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "我跟着林玉棠进了通道。她喊出声时，我在第一批到场的人里。", "requires": {"route": "跟过去"}}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "我留在侧厅看过约见处，听见林玉棠喊声后才赶到。", "requires": {"route": "留在侧厅"}}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "我先看见许济川的手指到林怀安颈侧时停了一瞬。", "requires": {"evidence": "neck_pause"}}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "我先确认林怀安倒在侧台岔口靠墙处。", "requires": {"evidence": "found_position"}}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "我先看见阿成站在人群外，陈九生随后从侧台另一端回来。", "requires": {"evidence": "crowd_arrival"}}], "next_rules": [{"requires": {"prepolice_action": "上天桥"}, "target": "c15_witness"}, {"target": "c16_followup"}], "on_enter": [{"method": "record_police_statement"}]},

    {
      "id": "c15_witness", "scene": "C15", "title": "天桥分支", "location": "侧厅外",
      "lines": [{"kind": "dialogue", "speaker": "后台伙计", "text": "林班主出事后，我看见那个记者从天桥下来。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "你上过？"}],
      "choices": [{"id": "c15_report", "label": "说明吊绳上的异常", "target": "c15_reported", "effects": [{"method": "report_rope_to_police", "args": [true]}]}, {"id": "c15_hide", "label": "只承认上过天桥", "target": "c15_hidden", "effects": [{"method": "report_rope_to_police", "args": [false]}]}]
    },
    {"id": "c15_reported", "scene": "C15", "title": "说明吊绳异常", "lines": [{"kind": "dialogue", "speaker": "沈砚舟", "text": "绳尾短半尺，横杆多绕一道，边缘有新麻毛。"}, {"kind": "dialogue", "speaker": "顾承钧", "text": "绳排平时谁管？"}, {"kind": "dialogue", "speaker": "陈九生", "text": "我。"}, {"kind": "narration", "text": "顾承钧让警员封住铁梯，先记录整排绳索。"}], "next": "c17_return"},
    {"id": "c15_hidden", "scene": "C15", "title": "只承认上过", "lines": [{"kind": "dialogue", "speaker": "沈砚舟", "text": "上去看过。没有别的。"}, {"kind": "narration", "text": "警方当晚没有记录具体吊绳状态。其他人的第一轮问话已经结束。"}], "next": "c17_return"},
    {"id": "c16_followup", "scene": "C16", "title": "现场收束", "location": "侧厅外", "lines": [{"kind": "narration", "text": "问完的人先后回到侧厅外等签字。沈砚舟只来得及根据自己已有的亲见或亲闻找一个人开口。"}], "choice_source": "followups"},
    {"id": "c16_yutang", "scene": "C16", "title": "追问玉棠", "lines": [{"kind": "dialogue", "speaker": "玉棠", "text": "那是我爹的东西。我当时只想先收起来。"}, {"kind": "narration", "text": "她没有回答自己是否把药盒往袖里收。"}], "next": "c16_sign"},
    {"id": "c16_xu", "scene": "C16", "title": "追问许济川", "lines": [{"kind": "dialogue", "speaker": "许济川", "text": "我在摸脉。死因要等验。", "requires": {"evidence": "neck_pause"}}, {"kind": "dialogue", "speaker": "许济川", "text": "我只知道他的旧病。死因要等验。", "requires": {"not_evidence": "neck_pause"}}, {"kind": "narration", "text": "现场医师没有判断死因。"}], "next": "c16_sign"},
    {"id": "c16_chen", "scene": "C16", "title": "追问陈九生", "lines": [{"kind": "dialogue", "speaker": "陈九生", "text": "你看见我走，没看见我去哪儿。对不对？", "requires": {"evidence": "chen_absent"}}, {"kind": "dialogue", "speaker": "陈九生", "text": "你只看见我回来。之前在哪儿，你没看见。", "requires": {"evidence": "crowd_arrival", "not_evidence": "chen_absent"}}, {"kind": "dialogue", "speaker": "陈九生", "text": "我问一句人在哪，也成了你的事？", "requires": {"evidence": "chen_asked_yutang", "not_evidence": ["chen_absent", "crowd_arrival"]}}, {"kind": "narration", "text": "他没有补出沈砚舟未曾看见的去向。"}], "next": "c16_sign"},
    {"id": "c16_fang", "scene": "C16", "title": "追问方仲山", "lines": [{"kind": "dialogue", "speaker": "方仲山", "text": "谢幕前后一直有人找我，前后台都走过。"}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "演到一半时，你的账桌空着。", "requires": {"evidence": "fang_left"}}, {"kind": "dialogue", "speaker": "沈砚舟", "text": "谢幕前后，你的账桌一直空着。", "requires": {"evidence": "fang_absent", "not_evidence": "fang_left"}}, {"kind": "dialogue", "speaker": "方仲山", "text": "你一直在看我？", "requires": {"evidence_any": ["fang_left", "fang_absent"]}}], "next": "c16_sign"},
    {"id": "c16_sign", "scene": "C16", "title": "签字", "lines": [{"kind": "dialogue", "speaker": "顾承钧", "text": "明天可能还会找你。住址写清楚。"}, {"kind": "narration", "text": "印章声接成报馆排字机落铅字的声音。"}], "next": "c17_return"},

    {
      "id": "c17_return", "scene": "C17-20", "title": "让哪句话见报", "location": "《雾港日报》｜接近十一点",
      "lines": [{"kind": "narration", "text": "排字房最后一栏仍空着。沈砚舟摊开采访本与稿纸。"}],
